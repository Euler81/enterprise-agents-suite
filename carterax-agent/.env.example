# Configuración de campaña (opcional: hay defaults)
MAX_DISCOUNT=0.30          # 30% máx. de descuento por pronto pago
MAX_INSTALLMENTS=6         # máx. cuotas
MIN_FIRST_PAYMENT=0.20     # primera cuota >= 20% de la deuda
MIN_RECOVERY_PV=0.65       # valor presente mínimo recuperado
ESCALATION_SENTIMENT=-0.5  # umbral de hostilidad para escalar
MONTHLY_RATE=0.04          # tasa de descuento mensual (costo de capital)
